{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the Ubuntu LTS tag and immutable digest synchronized between versions.env and the base Dockerfile",
      "managerFilePatterns": [
        "/^(?:versions\\.env|images/base/Dockerfile)$/"
      ],
      "matchStrings": [
        "(?:# renovate: datasource=docker depName=ubuntu versioning=ubuntu\\n)?(?:ARG )?UBUNTU_VERSION=(?<currentValue>\\d+\\.\\d+)\\n(?:ARG )?UBUNTU_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ubuntu",
      "versioningTemplate": "ubuntu"
    },
    {
      "customType": "regex",
      "description": "Keep the supported npm release synchronized between versions.env and the base Dockerfile",
      "managerFilePatterns": [
        "/^(?:versions\\.env|images/base/Dockerfile)$/"
      ],
      "matchStrings": [
        "(?:# renovate: datasource=npm depName=npm versioning=semver\\n)?(?:ARG )?NPM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "npm",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Track Ubuntu LTS releases only and group all base-image references",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu",
        "docker.io/library/ubuntu"
      ],
      "versioning": "ubuntu",
      "allowedVersions": "/^(?:[0-9]*[02468])\\.04$/",
      "groupName": "Ubuntu LTS base"
    },
    {
      "description": "Stay on the selected npm 12 line; future major migrations require explicit review",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "npm"
      ],
      "allowedVersions": "/^12\\./",
      "groupName": "npm 12 runtime"
    }
  ]
}
