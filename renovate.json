{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the effective Ubuntu LTS tag and immutable image digest in versions.env",
      "managerFilePatterns": [
        "/^versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>ubuntu) versioning=(?<versioning>ubuntu)\\nUBUNTU_VERSION=(?<currentValue>\\d+\\.\\d+)\\nUBUNTU_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    },
    {
      "customType": "regex",
      "description": "Keep the supported npm release synchronized between versions.env and the base Dockerfile",
      "managerFilePatterns": [
        "/^(?:versions\\.env|images/base/Dockerfile)$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>npm) depName=(?<depName>npm) versioning=(?<versioning>semver)\\n(?:ARG )?NPM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Track Ubuntu LTS releases only and group all base-image references",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu",
        "docker.io/library/ubuntu"
      ],
      "versioning": "ubuntu",
      "allowedVersions": "/^(?:[0-9]*[02468])\\.04$/",
      "groupName": "Ubuntu LTS base"
    },
    {
      "description": "Stay on the supported npm 11 line for the pinned Node 24 runtime",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "npm"
      ],
      "allowedVersions": "/^11\\./",
      "groupName": "npm 11 runtime"
    }
  ]
}
