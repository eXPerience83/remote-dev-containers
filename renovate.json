{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the Ubuntu LTS tag and immutable digest synchronized between versions.env and the base Dockerfile",
      "managerFilePatterns": [
        "/^(?:versions\\.env|images/base/Dockerfile)$/"
      ],
      "matchStrings": [
        "(?:# renovate: datasource=docker depName=ubuntu versioning=ubuntu\\n)?(?:ARG )?UBUNTU_VERSION=(?<currentValue>\\d+\\.\\d+)\\n(?:ARG )?UBUNTU_DIGEST=(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ubuntu",
      "versioningTemplate": "ubuntu"
    }
  ],
  "packageRules": [
    {
      "description": "Deny native Dockerfile ownership unless a later repository rule explicitly allows it",
      "matchManagers": [
        "dockerfile"
      ],
      "enabled": false
    },
    {
      "description": "Allow only the pinned Dockerfile frontend through the native Dockerfile manager",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "docker/dockerfile"
      ],
      "enabled": true
    },
    {
      "description": "Track Ubuntu LTS releases only and group all base-image references",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ubuntu",
        "docker.io/library/ubuntu"
      ],
      "versioning": "ubuntu",
      "allowedVersions": "/^(?:[0-9]*[02468])\\.04$/",
      "groupName": "Ubuntu LTS base"
    },
    {
      "description": "Runtime pins, digests, locks and legal notices are updated atomically by check-upstream.yml",
      "matchManagers": [
        "mise"
      ],
      "enabled": false
    },
    {
      "description": "Repository policy requires human merge review for every Renovate dependency",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    }
  ]
}
