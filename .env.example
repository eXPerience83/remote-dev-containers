# Image and host paths
# Channels: dev-amd64 = explicit pre-merge candidate testing;
# edge-amd64 = integrated experimental default; stable-amd64 = stable releases.
# `latest` is an alias of stable, never edge/dev. See docs/releases.md.
REMOTE_DEV_IMAGE=ghcr.io/experience83/remote-dev:edge-amd64
# Existing v0.1.x deployments may keep CODEX_IMAGE instead when REMOTE_DEV_IMAGE is unset.
# Host paths are resolved relative to compose/docker-compose.yml.
REMOTE_DEV_DATA_ROOT=../data

# Primary launcher endpoint. It contains no agent state and is unauthenticated by default.
# Optional file-backed Basic authentication uses compose/launcher-auth.yml.
LAUNCHER_BASE_PATH=/
LAUNCHER_CHECK_ORIGIN=1
LAUNCHER_PUBLISH_IP=127.0.0.1
LAUNCHER_PUBLISH_PORT=7680

# Optional validated project name used only by direct agent start modes.
# Leave empty in normal menu mode; the menu keeps its own transient selection.
REMOTE_DEV_PROJECT=

# Independently authenticated Codex terminal endpoint.
WEB_PUBLISH_IP=127.0.0.1
WEB_PUBLISH_PORT=7681
WEB_BASE_PATH=/
WEB_USERNAME=codex
WEB_MAX_CLIENTS=1
WEB_CHECK_ORIGIN=1
ALLOW_INSECURE_WEB=0
START_MODE=menu
TMUX_SESSION=codex

# Usually left empty: Compose maps these public values to the launcher's route.
REMOTE_DEV_CODEX_PUBLIC_HOST=
REMOTE_DEV_CODEX_PUBLIC_SCHEME=

# autonomous: no command confirmations. guarded: asks for confirmations.
REMOTE_DEV_CODEX_APPROVAL_MODE=autonomous

# Optional isolated Antigravity service. Start Compose with --profile antigravity
# and set this to 1 only when the service and its password/data paths are ready.
REMOTE_DEV_ENABLE_ANTIGRAVITY_SERVICE=0
ANTIGRAVITY_WEB_PUBLISH_IP=127.0.0.1
ANTIGRAVITY_WEB_PUBLISH_PORT=7682
ANTIGRAVITY_WEB_BASE_PATH=/
ANTIGRAVITY_WEB_USERNAME=antigravity
ANTIGRAVITY_WEB_MAX_CLIENTS=1
ANTIGRAVITY_WEB_CHECK_ORIGIN=1
ANTIGRAVITY_ALLOW_INSECURE_WEB=0
ANTIGRAVITY_START_MODE=menu
ANTIGRAVITY_TMUX_SESSION=antigravity
REMOTE_DEV_ANTIGRAVITY_PUBLIC_HOST=
REMOTE_DEV_ANTIGRAVITY_PUBLIC_SCHEME=
ANTIGRAVITY_GIT_USER_NAME=
ANTIGRAVITY_GIT_USER_EMAIL=

TZ=Europe/Madrid
GH_HOST=github.com
GIT_USER_NAME=
GIT_USER_EMAIL=

# Recommended authentication: leave this empty and use `codex login --device-auth`.
OPENAI_API_KEY=
CODEX_CA_CERTIFICATE=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
