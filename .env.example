# Image and host paths
CODEX_IMAGE=ghcr.io/experience83/codex-remote-dev:edge-amd64
CODEX_DATA_ROOT=./data
WEB_PASSWORD_PATH=./secrets/web_password.txt

# Bind only to localhost, a LAN address, or a Tailscale address.
WEB_PUBLISH_IP=127.0.0.1
WEB_PUBLISH_PORT=7681
WEB_BASE_PATH=/
WEB_USERNAME=codex
WEB_MAX_CLIENTS=1
WEB_CHECK_ORIGIN=1
ALLOW_INSECURE_WEB=0
START_MODE=menu
TMUX_SESSION=codex

TZ=Europe/Madrid
GH_HOST=github.com
GIT_USER_NAME=
GIT_USER_EMAIL=

# Recommended authentication: leave this empty and use `codex login --device-auth`.
OPENAI_API_KEY=
CODEX_CA_CERTIFICATE=

HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
