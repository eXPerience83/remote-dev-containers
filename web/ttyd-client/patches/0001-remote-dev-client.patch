new file mode 100755
index 0000000..88b5a97
--- /dev/null
+++ b/src/extensions.ts
@@ -0,0 +1,19 @@
+import type { IDisposable, Terminal } from '@xterm/xterm';
+
+export type ConnectionState = 'connecting' | 'open' | 'closed';
+
+export interface ExtensionContext {
+    terminal: Terminal;
+    uiMount: HTMLElement;
+    sendInput(data: string | Uint8Array): void;
+    requestFit(): void;
+    onConnectionStateChange(listener: (state: ConnectionState) => void): IDisposable;
+}
+
+export interface RemoteDevExtension {
+    activate(context: ExtensionContext): void | IDisposable | IDisposable[];
+}
+
+// #97 intentionally ships no product behavior. Clipboard and touch extensions
+// are owned by #91 and #90 and must use this single lifecycle-safe registry.
+export const extensions: readonly RemoteDevExtension[] = [];
